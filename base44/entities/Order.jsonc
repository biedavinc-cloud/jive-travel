{
  "name": "Order",
  "type": "object",
  "properties": {
    "item_type": {
      "type": "string",
      "enum": [
        "visa",
        "nationality"
      ]
    },
    "reference_id": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "amount_usd": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "card",
        "mobile_money"
      ]
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed"
      ],
      "default": "pending"
    }
  },
  "required": [
    "item_type",
    "amount_usd"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}